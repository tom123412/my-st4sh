@using System.Globalization
@using Microsoft.AspNetCore.Components

@if (Transactions.Count == 0)
{
    <div class="rounded-xl border border-dashed border-slate-300 px-6 py-12 text-center">
        <p class="font-semibold text-slate-800">No transactions yet</p>
        <p class="mt-1 text-sm text-slate-500">Transactions from the past six months will appear here.</p>
    </div>
}
else
{
    <div class="overflow-x-auto">
        <table class="w-full min-w-[640px] border-collapse text-left">
            <thead>
                <tr class="border-b border-slate-200 text-xs font-semibold uppercase tracking-wide text-slate-500">
                    <th scope="col" class="px-4 py-3">Date</th>
                    <th scope="col" class="px-4 py-3">Category</th>
                    <th scope="col" class="px-4 py-3">Type</th>
                    <th scope="col" class="px-4 py-3 text-right">Amount</th>
                    <th scope="col" class="px-4 py-3 text-right">Balance</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @foreach (var transaction in Transactions)
                {
                    <tr class="hover:bg-slate-50">
                        <td class="whitespace-nowrap px-4 py-4 text-sm text-slate-600">@transaction.Date.ToString("MMM d, yyyy", CultureInfo.InvariantCulture)</td>
                        <td class="px-4 py-4 text-sm font-medium text-slate-900">
                            @transaction.CategoryName
                            @if (transaction.IsExempt)
                            {
                                <span class="ml-2 rounded-full bg-emerald-50 px-2 py-0.5 text-xs font-medium text-emerald-700">Exempt</span>
                            }
                        </td>
                        <td class="px-4 py-4 text-sm text-slate-500">@transaction.CategoryTypeName</td>
                        <td class="whitespace-nowrap px-4 py-4 text-right text-sm font-semibold @(transaction.Amount < 0 ? "text-rose-700" : "text-slate-900")">@transaction.Amount.ToString("N2", CultureInfo.InvariantCulture)</td>
                        <td class="whitespace-nowrap px-4 py-4 text-right text-sm text-slate-600">@transaction.Balance.ToString("N2", CultureInfo.InvariantCulture)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<TransactionDto> Transactions { get; set; } = [];
}
